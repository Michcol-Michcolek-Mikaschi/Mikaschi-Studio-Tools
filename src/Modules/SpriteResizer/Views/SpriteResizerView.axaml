<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Modules.SpriteResizer.ViewModels"
             x:Class="Modules.SpriteResizer.Views.SpriteResizerView"
             x:DataType="vm:SpriteResizerViewModel">
    <Design.DataContext>
        <vm:SpriteResizerViewModel/>
    </Design.DataContext>
    <Grid RowDefinitions="Auto,*" Margin="16">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Sprite Resizer" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Skalowanie sprite'ów PNG z zachowaniem przezroczystości magenta" Opacity="0.7"/>
            <Separator/>
            <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Folder wejściowy:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding InputFolder}" PlaceholderText="Ścieżka do folderu z PNG..."/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder wyjściowy:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OutputFolder}" PlaceholderText="Ścieżka do folderu wyjściowego..."/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Szerokość (px):" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding TargetWidth}" Minimum="1" Maximum="1024"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Wysokość (px):" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding TargetHeight}" Minimum="1" Maximum="1024"/>
            </Grid>
            <Button Content="Skaluj batch" Command="{Binding ResizeCommand}"
                    IsEnabled="{Binding !IsBusy}" HorizontalAlignment="Left"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
            <TextBox Text="{Binding StatusLog}" IsReadOnly="True" TextWrapping="Wrap"
                     FontFamily="Monospace" AcceptsReturn="True"/>
        </ScrollViewer>
    </Grid>
</UserControl>
