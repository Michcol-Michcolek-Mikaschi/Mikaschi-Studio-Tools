<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Modules.ObjectBuilder.Views.LegacyExportWindow"
        Title="Eksport obiektów"
        Width="520" Height="350"
        MinWidth="480" MinHeight="330"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#111827" Padding="16,12" BorderBrush="#26344B" BorderThickness="0,0,0,1">
            <StackPanel Spacing="3">
                <TextBlock Text="Eksport obiektów" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="SelectionSummaryText" Classes="muted" FontSize="11"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="18" Spacing="13">
            <StackPanel Spacing="5">
                <TextBlock Text="Nazwa bazowa" Classes="muted"/>
                <TextBox x:Name="BaseNameTextBox" PlaceholderText="item"/>
            </StackPanel>

            <StackPanel Spacing="5">
                <TextBlock Text="Folder docelowy" Classes="muted"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                    <TextBox x:Name="OutputFolderTextBox" Grid.Column="0" IsReadOnly="True"/>
                    <Button Grid.Column="1" Content="Przeglądaj…" Click="BrowseFolder_Click"/>
                </Grid>
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="Format" Classes="muted"/>
                    <ComboBox x:Name="FormatComboBox" SelectedIndex="0">
                        <ComboBoxItem Content="PNG — obraz bezstratny"/>
                        <ComboBoxItem Content="BMP — mapa bitowa"/>
                        <ComboBoxItem Content="JPG — obraz skompresowany"/>
                        <ComboBoxItem Content="OBD — Object Builder Data"/>
                        <ComboBoxItem Content="AEC — Assets Editor Container"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Bottom">
                    <CheckBox x:Name="TransparentBackgroundCheckBox" Content="Przezroczyste tło" IsChecked="True"/>
                    <TextBlock Text="OBD i obrazy tworzą osobne pliki. AEC zapisuje zaznaczenie w jednym kontenerze."
                               Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Background="#111827" Padding="12" BorderBrush="#26344B" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Anuluj" MinWidth="92" Click="Cancel_Click"/>
                <Button Content="Eksportuj" MinWidth="110" Click="Confirm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
