<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Modules.ObjectBuilder.Views.LegacyDeleteConfirmationWindow"
        Title="Usuń obiekty"
        Width="480" Height="275"
        MinWidth="480" MinHeight="275"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#291218" Padding="16,12" BorderBrush="#7F1D1D" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Text="!" FontSize="23" FontWeight="Bold" Foreground="#FCA5A5" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="Potwierdź usunięcie" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SelectionSummaryText" Classes="muted" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="18" Spacing="11">
            <TextBlock Text="Usunięte zostaną obiekty z Tibia.dat. Sprite'y pozostaną w Tibia.spr, ponieważ mogą być używane przez inne obiekty."
                       TextWrapping="Wrap"/>
            <Border x:Name="RenumberWarningBorder" Background="#3B230E" BorderBrush="#92400E" BorderThickness="1" CornerRadius="5" Padding="10">
                <TextBlock Text="Stary format DAT nie obsługuje luk. Późniejsze obiekty w tej kategorii dostaną nowe ID — sprawdź odwołania skryptów serwera."
                           Foreground="#FCD34D" TextWrapping="Wrap" FontSize="11"/>
            </Border>
            <TextBlock Text="Zmiana pozostanie tylko w pamięci do czasu użycia przycisku „Zapisz Tibia.dat”."
                       Classes="muted" TextWrapping="Wrap" FontSize="10"/>
        </StackPanel>

        <Border Grid.Row="2" Background="#111827" Padding="12" BorderBrush="#26344B" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Anuluj" MinWidth="92" Click="Cancel_Click"/>
                <Button Content="Usuń" MinWidth="110" Background="#991B1B" Click="Confirm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
