<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
        <Setter Property="Background" Value="#080D16"/>
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Padding" Value="12,6"/>
    </Style>

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="30"/>
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="30"/>
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="MinHeight" Value="30"/>
    </Style>

    <Style Selector="Border.app-surface">
        <Setter Property="Background" Value="#0C1322"/>
        <Setter Property="BorderBrush" Value="#1E2A3D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Border.app-panel">
        <Setter Property="Background" Value="#111827"/>
        <Setter Property="BorderBrush" Value="#223149"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Border.app-commandbar">
        <Setter Property="Background" Value="#0F172A"/>
        <Setter Property="BorderBrush" Value="#1F2A44"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#E5EDF8"/>
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="#94A3B8"/>
    </Style>

    <Style Selector="TextBlock.subtle">
        <Setter Property="Foreground" Value="#64748B"/>
    </Style>

    <Style Selector="Button.icon-button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="ToggleButton.direction-button">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="#111827"/>
        <Setter Property="BorderBrush" Value="#334155"/>
    </Style>

    <Style Selector="ToggleButton.direction-button:checked">
        <Setter Property="Background" Value="#0B4F8A"/>
        <Setter Property="BorderBrush" Value="#38BDF8"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Border.texture-stage">
        <Setter Property="Background" Value="#070B12"/>
        <Setter Property="BorderBrush" Value="#2B3B55"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="Border.drop-target">
        <Setter Property="Background" Value="#101827"/>
        <Setter Property="BorderBrush" Value="#3B82F6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
</Styles>
