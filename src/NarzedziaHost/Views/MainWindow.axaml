<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NarzedziaHost.ViewModels"
        x:DataType="vm:MainWindowViewModel"
        x:Class="NarzedziaHost.Views.MainWindow"
        Title="Mikaschi Studio Tools"
        Width="1500" Height="900"
        MinWidth="1080" MinHeight="700">

    <Grid ColumnDefinitions="260,*" Background="#080D16">
        <Border Grid.Column="0" Background="#0B1120" BorderBrush="#1E2A3D" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <Border Padding="16,18,16,16" BorderBrush="#1E2A3D" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                            <Border Width="36" Height="36" CornerRadius="8" Background="#0B4F8A">
                                <TextBlock Text="MS"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="#EAF6FF"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Mikaschi Studio Tools" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="modułowe narzędzia OTS" FontSize="11" Foreground="#8EA2BD"/>
                            </StackPanel>
                        </Grid>

                        <Border Classes="app-surface" Padding="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="*" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Aktywny moduł" FontSize="10" Foreground="#8EA2BD"/>
                                    <TextBlock Text="{Binding SelectedModule.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Modules}"
                         SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                         Background="Transparent"
                         Padding="8,10"
                         BorderThickness="0">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Padding" Value="8"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                                <Border Width="32" Height="32" CornerRadius="7" Background="#111827">
                                    <TextBlock Text="*"
                                               FontSize="14"
                                               Foreground="#7DD3FC"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                               Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}" FontSize="10.5"
                                               Foreground="#8EA2BD" TextWrapping="Wrap"
                                               MaxHeight="42"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Padding="14" BorderBrush="#1E2A3D" BorderThickness="0,1,0,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="Język" FontWeight="SemiBold" FontSize="12" Foreground="#E5EDF8"/>
                                <TextBlock Text="{Binding CurrentLanguageCode}" FontSize="10.5" Foreground="#8EA2BD"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableLanguages}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                      ToolTip.Tip="Zmień język aplikacji"
                                      MinWidth="112">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LanguageOption">
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Border Height="1" Background="#1E2A3D"/>
                        <TextBlock Text="Migracja /src" FontWeight="SemiBold" FontSize="12" Foreground="#E5EDF8"/>
                        <TextBlock Text="AssetsEditor: in-progress | Lapis: in-progress"
                                   FontSize="11" Foreground="#8EA2BD" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Classes="app-commandbar" Padding="16,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding SelectedModule.Name}" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        <TextBlock Text="{Binding SelectedModule.Description}" FontSize="11" Foreground="#8EA2BD" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Classes="app-surface" Padding="10,5">
                            <TextBlock Text="Avalonia 12 + Semi" FontSize="11" Foreground="#A7F3D0"/>
                        </Border>
                        <Border Classes="app-surface" Padding="10,5">
                            <TextBlock Text="Free UI stack" FontSize="11" Foreground="#BAE6FD"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#050911">
                <ContentControl Content="{Binding CurrentView}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding}"/>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
