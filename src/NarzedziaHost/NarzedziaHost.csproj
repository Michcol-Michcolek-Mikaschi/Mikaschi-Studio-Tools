<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Product>Mikaschi Studio Tools</Product>
    <AssemblyTitle>Mikaschi Studio Tools</AssemblyTitle>
    <PublishDir>$(BuildRoot)Mikaschi-Studio-Tools-win-x64\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Override vulnerable transitive dependency from Avalonia. Version is centralized. -->
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Semi.Avalonia" />
    <PackageReference Include="Semi.Avalonia.DataGrid" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Narzedzia.Contracts\Narzedzia.Contracts.csproj" />
    <ProjectReference Include="..\Narzedzia.Core\Narzedzia.Core.csproj" />
    <ProjectReference Include="..\Modules\AssetsEditor\Modules.AssetsEditor.csproj" />
    <ProjectReference Include="..\Modules\ObjectBuilder\Modules.ObjectBuilder.csproj" />
    <ProjectReference Include="..\Modules\LapisItemEditor\Modules.LapisItemEditor.csproj" />
    <ProjectReference Include="..\Modules\OldItemEditor\Modules.OldItemEditor.csproj" />
    <ProjectReference Include="..\Modules\SpiderConverter\Modules.SpiderConverter.csproj" />
    <ProjectReference Include="..\Modules\SpriteResizer\Modules.SpriteResizer.csproj" />
    <ProjectReference Include="..\Modules\SpriteSheetCutter\Modules.SpriteSheetCutter.csproj" />
    <ProjectReference Include="..\Modules\MapEditor\Modules.MapEditor.csproj" />
    <ProjectReference Include="..\Modules\SpriteGenerator\Modules.SpriteGenerator.csproj" />
  </ItemGroup>

</Project>
